{
  "name": "misku-native-view-cli",
  "version": "0.3.0",
  "description": "Create isolated native Windows web apps from URLs",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohannRojas/misku-native-view"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "misku-nv": "./bin/misku.js",
    "misku": "./bin/misku.js",
    "misku-native-views": "./bin/misku.js"
  },
  "files": [
    "bin/favicon.js",
    "bin/misku.js",
    "runtime/misku-native-views.exe",
    "scripts/manage-shortcut.ps1",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/misku-cli.test.js test/favicon.test.js test/release.test.js",
    "test:ui": "playwright test",
    "test:native": "node scripts/native-smoke.cjs",
    "tauri": "tauri",
    "prepack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-pnpm-package.ps1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4"
  },
  "keywords": [
    "tauri",
    "webview",
    "windows",
    "cli",
    "desktop"
  ],
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
